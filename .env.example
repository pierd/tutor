# Frontend (read by Vite at build time; set in .env.local and in the hosting build env)
VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=https://wieprz.lessismore.studio/eu

# Backend LLM analytics. Convex does NOT read this file: set these on each
# deployment with `npx convex env set POSTHOG_PROJECT_TOKEN ...` (add --prod for prod).
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
